<div class="hud-conteudo">

  {{!-- Retrato maior que o painel: ocupa a altura do status e vaza em cima e embaixo --}}
  <div class="hud-retrato hud-tem-tip" data-action="abrirFicha">
    <button type="button" class="hud-retrato-abrir" data-action="abrirFicha" aria-label="{{retrato.rotulo}}"></button>
    <div class="hud-retrato-abertura">
      <img class="hud-t20-enq" src="{{retrato.img}}" style="{{retrato.estilo}}" alt="" draggable="false">
    </div>
    <img class="hud-retrato-moldura" src="modules/hud-t20/assets/moldura-retrato.webp" alt="">
    {{#if retrato.podeEditar}}
    <button type="button" class="hud-retrato-ajustar" data-action="ajustarRetrato" aria-label="{{retrato.rotuloAjustar}}">
      <i class="fa-solid fa-gear" aria-hidden="true"></i>
    </button>
    {{/if}}
    <div class="hud-tip" role="tooltip">
      <div class="cab"><span class="sec">{{ator.nome}}</span><b>{{ator.nivelTxt}}</b></div>
      <ul>
        <li><b>{{retrato.dicaClique}}</b><span></span><small>{{retrato.dicaCliqueSub}}</small></li>
        {{#if retrato.podeEditar}}
        <li><b>{{retrato.dicaDireito}}</b><span></span><small>{{retrato.dicaDireitoSub}}</small></li>
        {{/if}}
      </ul>
    </div>
  </div>

  <div class="hud-status">
    {{#if condicoes.length}}
    <ul class="hud-condicoes">
      {{#each condicoes}}
      <li class="hud-cond hud-tem-tip" tabindex="0" aria-label="{{nome}}">
        <img src="{{img}}" alt="">
        <div class="hud-tip" role="tooltip">
          <div class="sec">{{secao}}</div>
          <ul><li><b>{{nome}}</b><span></span>{{#if descricao}}<small>{{descricao}}</small>{{/if}}</li></ul>
          <div class="sec sec-2">{{@root.rotuloMudancas}}</div>
          <ul>
            {{#each mudancas}}<li><b>{{rot}}</b><span class="n">{{val}}</span></li>{{else}}<li class="ext"><b>{{semMudancas}}</b><span></span></li>{{/each}}
          </ul>
        </div>
      </li>
      {{/each}}
    </ul>
    {{/if}}

    {{#each recursos}}
    <div class="hud-recurso">
      <span class="hud-recurso-rot">{{#if icone}}<img class="hud-recurso-ic" src="{{icone}}" alt="">{{/if}}<span class="hud-recurso-txt">{{rotulo}}</span></span>
      <div class="hud-trilho" role="meter" aria-label="{{rotulo}}" aria-valuemin="0" aria-valuemax="{{max}}" aria-valuenow="{{value}}">
        <div class="vazio"></div>
        <div class="cheio {{classe}}" style="--pct:{{pct}}"></div>
        {{#if temp}}<div class="extra {{classe}}" style="--pct:{{tempPct}}"></div>{{/if}}
        <div class="txt">{{value}} / {{max}}{{#if temp}} <small>(+{{temp}})</small>{{/if}}</div>
      </div>
    </div>
    {{/each}}

    <div class="hud-minis">
      {{#each stats}}
      {{#if clicavel}}
      <button type="button" class="hud-mini hud-mini-clicavel hud-tem-tip" data-action="iniciativa" aria-label="{{rotulo}} {{valor}}. {{pe}}">
        <svg class="dado" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 2l9 5v10l-9 5-9-5V7z"/><path d="M12 2v20M3 7l18 10M21 7L3 17"/></svg>
      {{else}}
      <div class="hud-mini hud-tem-tip" tabindex="0" aria-label="{{rotulo}}: {{valor}}">
      {{/if}}
        <span class="val"><img src="{{icone}}" alt="">{{valor}}</span>
        <div class="hud-tip" role="tooltip">
          <div class="cab"><span class="sec">{{rotulo}}</span><b>{{valor}}</b></div>
          <ul>
            {{#each linhas}}
            <li class="{{#if ext}}ext{{/if}}"><b>{{rot}}</b><span class="n">{{val}}</span>{{#if sub}}<small>{{sub}}</small>{{/if}}</li>
            {{/each}}
          </ul>
          {{#if pe}}
          <div class="pe">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 2l9 5v10l-9 5-9-5V7z"/></svg>
            <span>{{pe}}</span>
          </div>
          {{/if}}
        </div>
      {{#if clicavel}}</button>{{else}}</div>{{/if}}
      {{/each}}
    </div>
  </div>

  <div class="hud-turno">
    {{#if combate}}
    <div class="hud-acoes">
      {{#each acoes}}
      <button type="button" class="hud-acao {{#if meio}}meio{{/if}} {{#if gasta}}gasta{{/if}}" data-action="acao" data-acao="{{chave}}"
        aria-pressed="{{#if gasta}}true{{else}}false{{/if}}" aria-label="{{dica}}" data-tooltip="{{dica}}" {{#unless ../podeMarcar}}disabled{{/unless}}>
        <img src="{{img}}" alt="">
      </button>
      {{/each}}
    </div>
    {{/if}}
    {{#unless combate}}{{#if acoesDecorativas}}
    {{!-- Temas (0.4.0): fora de combate, os losangos cobrem os desenhados na arte, apagados e sem clique --}}
    <div class="hud-acoes fora" aria-hidden="true">
      {{#each acoes}}<span class="hud-acao"><img src="{{img}}" alt=""></span>{{/each}}
    </div>
    {{/if}}{{/unless}}
    <div class="hud-gema {{#if vez}}vez{{/if}}" role="status">
      {{!-- Nos temas (0.4.0), o olho da tempestade e a bússola fazem o papel do cristal: só o brilho e a legenda --}}
      <span class="brilho" aria-hidden="true"></span>
      <img src="{{gema}}" alt="">
      <span class="leg">{{legendaGema}}</span>
    </div>
  </div>

</div>
